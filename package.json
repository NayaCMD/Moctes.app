{
  "name": "moctes",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=frontend\" \"npm run start:dev --workspace=backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run start:dev --workspace=backend",
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend",
    "lint": "npm run lint:fast && npm run lint:full",
    "lint:fast": "oxlint .",
    "lint:full": "npm run lint:full --workspace=frontend && npm run lint:full --workspace=backend",
    "typecheck": "npm run typecheck --workspace=frontend && npm run typecheck --workspace=backend",
    "prepare": "husky",
    "commit": "cz"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "concurrently": "^10.0.3",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "commitizen": "^4.3.2",
    "cz-git": "^1.13.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "oxlint": "^1.74.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  }
}